# Copy to .env. Never commit .env.
# --- models (Anthropic API only). Empty key = the replay stub (recorded experiment outputs). ---
ANTHROPIC_API_KEY=
MODEL_WRITER=claude-fable-5-1           # the model under test; T7 parity — the experiment's best line came from Fable 5.1
MODEL_WRITER_2=claude-sonnet-5          # second writer, for the cross-model checks (T1 identical-sentence)
MODEL_READER=claude-sonnet-5            # independent verifier only — never the gate
STUB_MODEL=
SEND_APPROVAL_REQUIRED=true

# --- observability ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=sales-agent-t-series
DEEPEVAL_TELEMETRY_OPT_OUT=YES

# --- optional: durable approval (Docker Postgres) ---
# POSTGRES_URI=postgresql://sales:sales-sandbox-pw@localhost:5432/sales

# Copy to .env. Never commit .env.
# --- models: API only. Leave the key empty to run everything on the deterministic stub. ---
ANTHROPIC_API_KEY=
MODEL_MEDIUM=claude-sonnet-5              # writes the three candidates
MODEL_SMALL=claude-haiku-4-5-20251001     # answers the six reader checks
STUB_MODEL=                               # set to 1 to force the stub even with a key
VOYAGE_API_KEY=                           # optional: embeddings API for vector retrieval

# --- services. Leave commented for a local-only setup (in-memory checkpointer + Kùzu graph).
# setup_env.sh uncomments POSTGRES_URI and NEO4J_URI automatically when Docker services come up.
# POSTGRES_URI=postgresql://sales:sales-sandbox-pw@localhost:5432/sales
POSTGRES_USER=sales
POSTGRES_PASSWORD=sales-sandbox-pw
POSTGRES_DB=sales
# NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sales-sandbox-pw
KUZU_DIR=./data/kuzu

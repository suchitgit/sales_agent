# --- append to .env ---
# LangSmith tracing: every node and model call of every run, plus experiments
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=sales-agent
# DeepEval: no key needed for the deterministic metrics. The judged metric uses the Anthropic key above.
# Do NOT set OPENAI_API_KEY — the judge is Anthropic-backed on purpose.
